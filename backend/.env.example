# NEXUS AI backend — copy to .env for local development, or set as Railway Variables.
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL on Railway: refer to the Postgres service variable.
# Example: postgresql+asyncpg://user:pass@host:5432/railway
DATABASE_URL=

# Long random string used to sign JWT access tokens.
JWT_SECRET=

# Gemini stays on the server. Never put this key inside the iOS app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional hardening
CORS_ORIGINS=*
ACCESS_TOKEN_MINUTES=43200
ALLOW_REGISTRATION=true
